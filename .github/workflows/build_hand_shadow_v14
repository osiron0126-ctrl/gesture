          cat > generated-android/app/src/main/java/com/sc/millegesture/GestureAccessibilityService.kt <<'SC_FILE_EOF'
          package com.sc.millegesture
          import android.accessibilityservice.AccessibilityService
          import android.accessibilityservice.GestureDescription
          import android.app.KeyguardManager
          import android.content.Intent
          import android.graphics.Path
          import android.graphics.Rect
          import android.os.Handler
          import android.os.Looper
          import android.view.accessibility.AccessibilityEvent
          import android.view.accessibility.AccessibilityWindowInfo
          
          class GestureAccessibilityService : AccessibilityService() {
              companion object { @Volatile var instance: GestureAccessibilityService? = null; private set }
              private var busy = false
              private val handler = Handler(Looper.getMainLooper())
              private var dragStroke: GestureDescription.StrokeDescription? = null
              private var dragBounds: Rect? = null
              private var dragLast: Pair<Float, Float>? = null
              private var dragPending: Pair<Float, Float>? = null
              private var dragEnding = false
              private var dragDispatching = false
              override fun onServiceConnected() { super.onServiceConnected(); instance = this }
              override fun onAccessibilityEvent(event: AccessibilityEvent?) = Unit
              override fun onInterrupt() { AppController.stopAll(this); HandOverlayManager.remove() }
              override fun onDestroy() {
                  if (instance === this) instance = null
                  AppController.stopAll(this)
                  HandOverlayManager.remove(); handler.removeCallbacksAndMessages(null); super.onDestroy()
              }
              private fun focusedApplication(): Pair<AccessibilityWindowInfo, Rect>? {
                  val win = windows.firstOrNull {
                      it.type == AccessibilityWindowInfo.TYPE_APPLICATION && it.isFocused
                  } ?: windows.firstOrNull {
                      it.type == AccessibilityWindowInfo.TYPE_APPLICATION && it.isActive
                  } ?: return null
                  val root = win.root ?: return null
                  val pkg = root.packageName?.toString()
                  @Suppress("DEPRECATION") root.recycle()
                  if (pkg == packageName) return null
                  val bounds = Rect()
                  win.getBoundsInScreen(bounds)
                  if (bounds.width() < 100 || bounds.height() < 100) return null
                  return win to bounds
              }
          
              fun tapAt(normalizedX: Float, normalizedY: Float): Boolean {
                  if (busy || getSystemService(KeyguardManager::class.java).isKeyguardLocked) return false
                  val (_, bounds) = focusedApplication() ?: return false
                  val x = (bounds.left + normalizedX.coerceIn(0.02f, 0.98f) * bounds.width())
                      .coerceIn(bounds.left.toFloat(), bounds.right.toFloat() - 1f)
                  val y = (bounds.top + normalizedY.coerceIn(0.02f, 0.98f) * bounds.height())
                      .coerceIn(bounds.top.toFloat(), bounds.bottom.toFloat() - 1f)
                  return dispatchTap(x, y)
              }
          
              /** Begins a real continued touch so compatible apps receive pointer-down and movement. */
              fun startDrag(
                  normalizedStart: Pair<Float, Float>,
                  normalizedCurrent: Pair<Float, Float>
              ): Boolean {
                  if (busy || getSystemService(KeyguardManager::class.java).isKeyguardLocked) return false
                  val (_, bounds) = focusedApplication() ?: return false
                  val start = mapPoint(normalizedStart, bounds)
                  val current = mapPoint(normalizedCurrent, bounds)
                  val path = Path().apply {
                      moveTo(start.first, start.second)
                      if (distance(start, current) >= 1f) lineTo(current.first, current.second)
                  }
                  val stroke = GestureDescription.StrokeDescription(path, 0L, 140L, true)
                  busy = true
                  dragBounds = Rect(bounds)
                  dragLast = current
                  dragPending = null
                  dragEnding = false
                  return dispatchDragStroke(stroke, finalStroke = false)
              }
          
              /** Stores only the newest camera position while the previous drag segment is dispatched. */
              fun moveDrag(normalizedPoint: Pair<Float, Float>): Boolean {
                  val bounds = dragBounds ?: return false
                  if (dragStroke == null || dragEnding) return false
                  dragPending = mapPoint(normalizedPoint, bounds)
                  return true
              }
          
              /** Releases the continued touch at the last delivered point. */
              fun endDrag(): Boolean {
                  if (dragStroke == null) return false
                  dragEnding = true
                  if (!dragDispatching) dispatchNextDragSegment()
                  return true
              }
          
              private fun dispatchTap(x: Float, y: Float): Boolean {
                  val path = Path().apply { moveTo(x, y) }
                  val gesture = GestureDescription.Builder()
                      .addStroke(GestureDescription.StrokeDescription(path, 0, 65L))
                      .build()
                  busy = true
                  val accepted = dispatchGesture(gesture, object : GestureResultCallback() {
                      override fun onCompleted(gestureDescription: GestureDescription?) { busy = false }
                      override fun onCancelled(gestureDescription: GestureDescription?) {
                          busy = false
                          RuntimeState.message = "터치 취소됨 · 다시 시도하세요"
                      }
                  }, handler)
                  if (!accepted) busy = false
                  return accepted
              }
          
              private fun dispatchDragStroke(
                  stroke: GestureDescription.StrokeDescription,
                  finalStroke: Boolean
              ): Boolean {
                  dragStroke = stroke
                  dragDispatching = true
                  val gesture = GestureDescription.Builder().addStroke(stroke).build()
                  val accepted = dispatchGesture(gesture, object : GestureResultCallback() {
                      override fun onCompleted(gestureDescription: GestureDescription?) {
                          dragDispatching = false
                          if (finalStroke) clearDrag() else dispatchNextDragSegment()
                      }
          
                      override fun onCancelled(gestureDescription: GestureDescription?) {
                          clearDrag()
                          RuntimeState.message = "드래그 취소됨 · 다시 시도하세요"
                      }
                  }, handler)
                  if (!accepted) clearDrag()
                  return accepted
              }
          
              private fun dispatchNextDragSegment() {
                  val previousStroke = dragStroke ?: return
                  val last = dragLast ?: return clearDrag()
                  val target = dragPending
                  dragPending = null
                  val finalStroke = dragEnding
                  val path = Path().apply {
                      moveTo(last.first, last.second)
                      if (target != null && distance(last, target) >= 1f) {
                          lineTo(target.first, target.second)
                      }
                  }
                  if (target != null) dragLast = target
                  val duration = when {
                      finalStroke -> 1L
                      target != null -> 90L
                      else -> 180L
                  }
                  val continuation = previousStroke.continueStroke(path, 0L, duration, !finalStroke)
                  dispatchDragStroke(continuation, finalStroke)
              }
          
              private fun clearDrag() {
                  dragStroke = null
                  dragBounds = null
                  dragLast = null
                  dragPending = null
                  dragEnding = false
                  dragDispatching = false
                  busy = false
              }
          
              private fun mapPoint(normalized: Pair<Float, Float>, bounds: Rect): Pair<Float, Float> {
                  val x = bounds.left + normalized.first.coerceIn(.02f, .98f) * bounds.width()
                  val y = bounds.top + normalized.second.coerceIn(.02f, .98f) * bounds.height()
                  return x.coerceIn(bounds.left.toFloat(), bounds.right.toFloat() - 1f) to
                      y.coerceIn(bounds.top.toFloat(), bounds.bottom.toFloat() - 1f)
              }
          
              private fun distance(a: Pair<Float, Float>, b: Pair<Float, Float>): Float = kotlin.math.hypot(
                  (a.first - b.first).toDouble(),
                  (a.second - b.second).toDouble()
              ).toFloat()
          
              fun performScroll(direction: Direction): Boolean {
                  if (busy || getSystemService(KeyguardManager::class.java).isKeyguardLocked) return false
                  val (_, b) = focusedApplication() ?: return false
                  if (b.width() < 100 || b.height() < 100) return false
                  val prefs = getSharedPreferences("settings", MODE_PRIVATE)
                  val cx = b.exactCenterX()
                  val cy = b.exactCenterY()
                  val path = Path()
                  val span = .22f + .48f * prefs.getInt("distance", 50).coerceIn(0, 100) / 100f
                  when (direction) {
                      Direction.LEFT, Direction.RIGHT -> {
                          var right = direction == Direction.RIGHT
                          if (prefs.getBoolean("reverseX", false)) right = !right
                          val delta = b.width() * span / 2f
                          if (right) {
                              path.moveTo(cx - delta, cy)
                              path.lineTo(cx + delta, cy)
                          } else {
                              path.moveTo(cx + delta, cy)
                              path.lineTo(cx - delta, cy)
                          }
                      }
                      Direction.UP, Direction.DOWN -> {
                          var down = direction == Direction.DOWN
                          if (prefs.getBoolean("reverseY", false)) down = !down
                          val delta = b.height() * span / 2f
                          if (down) {
                              path.moveTo(cx, cy - delta)
                              path.lineTo(cx, cy + delta)
                          } else {
                              path.moveTo(cx, cy + delta)
                              path.lineTo(cx, cy - delta)
                          }
                      }
                  }
                  val gesture = GestureDescription.Builder()
                      .addStroke(GestureDescription.StrokeDescription(path, 0, 430L))
                      .build()
                  busy = true
                  val accepted = dispatchGesture(gesture, object : GestureResultCallback() {
                      override fun onCompleted(gestureDescription: GestureDescription?) { busy = false }
                      override fun onCancelled(gestureDescription: GestureDescription?) {
                          busy = false
                          RuntimeState.message = "스크롤 취소됨 · 다시 시도하세요"
                      }
                  }, handler)
                  if(!accepted) busy = false
                  return accepted
              }
          }
          SC_FILE_EOF
          mkdir -p generated-android/app/src/main/java/com/sc/millegesture
          cat > generated-android/app/src/main/java/com/sc/millegesture/GestureCameraService.kt <<'SC_FILE_EOF'
          package com.sc.millegesture
          
          import android.Manifest
          import android.app.Notification
          import android.app.NotificationChannel
          import android.app.NotificationManager
          import android.app.PendingIntent
          import android.content.BroadcastReceiver
          import android.content.Context
          import android.content.Intent
          import android.content.IntentFilter
          import android.content.pm.PackageManager
          import android.graphics.Bitmap
          import android.graphics.Matrix
          import android.hardware.display.DisplayManager
          import android.media.AudioManager
          import android.os.Handler
          import android.os.Looper
          import android.os.SystemClock
          import android.util.Size
          import android.view.Surface
          import androidx.camera.core.CameraSelector
          import androidx.camera.core.ImageAnalysis
          import androidx.camera.core.ImageProxy
          import androidx.camera.lifecycle.ProcessCameraProvider
          import androidx.core.app.NotificationCompat
          import androidx.core.content.ContextCompat
          import androidx.lifecycle.LifecycleService
          import com.google.mediapipe.framework.image.BitmapImageBuilder
          import com.google.mediapipe.tasks.components.containers.Category
          import com.google.mediapipe.tasks.core.BaseOptions
          import com.google.mediapipe.tasks.vision.core.RunningMode
          import com.google.mediapipe.tasks.vision.handlandmarker.HandLandmarker
          import com.google.mediapipe.tasks.vision.handlandmarker.HandLandmarkerResult
          import java.util.concurrent.Executors
          
          class GestureCameraService : LifecycleService() {
              companion object {
                  const val ACTION_STOP = "com.sc.millegesture.STOP"
                  private const val CHANNEL_ID = "gesture_camera"
                  private const val NOTIFICATION_ID = 4101
              }
          
              private val worker = Executors.newSingleThreadExecutor()
              private val main = Handler(Looper.getMainLooper())
              private var provider: ProcessCameraProvider? = null
              private var analysis: ImageAnalysis? = null
              private var landmarker: HandLandmarker? = null // Created and closed on worker.
              private val twoFingerEngine = TwoFingerGestureEngine() // Used only on main.
              private val rightInputEngine = RightHandInputEngine() // Used only on main.
              private val rightPinchStabilizer = RightPinchPoseStabilizer() // Used only on main.
              @Volatile private var alive = true
              private var started = false
              private var failed = false
              private var lastSubmitted = 0L
              private var startAt = 0L
              private var lastRotation = -1
              private var framesFailed = 0
              private var lastRightPalm: Pair<Float, Float>? = null // Worker thread only.
              private var lastLeftPalm: Pair<Float, Float>? = null // Worker thread only.
          
              private val screenOff = object : BroadcastReceiver() {
                  override fun onReceive(context: Context?, intent: Intent?) { stopSelf() }
              }
          
              private val watchdog = object : Runnable {
                  override fun run() {
                      if (!alive || !started) return
                      if (GestureAccessibilityService.instance == null) {
                          fail("접근성 연결이 끊겼습니다")
                          return
                      }
                      val since = if (RuntimeState.lastFrame == 0L) startAt else RuntimeState.lastFrame
                      if (SystemClock.uptimeMillis() - since > 15000L) {
                          fail("15초 동안 카메라 영상 없음 · 카메라를 쓰는 앱을 닫고 다시 START")
                          return
                      }
                      main.postDelayed(this, 1000L)
                  }
              }
          
              override fun onCreate() {
                  super.onCreate()
                  getSystemService(NotificationManager::class.java).createNotificationChannel(
                      NotificationChannel(CHANNEL_ID, "손 제스처", NotificationManager.IMPORTANCE_LOW)
                  )
                  ContextCompat.registerReceiver(
                      this,
                      screenOff,
                      IntentFilter(Intent.ACTION_SCREEN_OFF),
                      ContextCompat.RECEIVER_NOT_EXPORTED
                  )
              }
          
              override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
                  // LifecycleService must receive the parent start callback before work begins.
                  super.onStartCommand(intent, flags, startId)
                  if (intent?.action == ACTION_STOP) {
                      stopSelf()
                      return START_NOT_STICKY
                  }
                  try {
                      startForeground(NOTIFICATION_ID, notification())
                  } catch (e: Exception) {
                      fail("카메라 서비스 시작 실패: ${e.message}")
                      return START_NOT_STICKY
                  }
                  if (started) return START_NOT_STICKY
                  if (ContextCompat.checkSelfPermission(this, Manifest.permission.CAMERA) !=
                      PackageManager.PERMISSION_GRANTED
                  ) {
                      fail("카메라 권한이 필요합니다")
                      return START_NOT_STICKY
                  }
          
                  started = true
                  RuntimeState.running = true
                  RuntimeState.lastFrame = 0L
                  RuntimeState.message = "모델·카메라 준비 중"
                  runCatching { AppController.startClapStandby(this) }
                  startAt = SystemClock.uptimeMillis()
                  twoFingerEngine.reset()
                  rightInputEngine.reset()
                  rightPinchStabilizer.reset()
                  main.post(watchdog)
          
                  worker.execute {
                      try {
                          val options = HandLandmarker.HandLandmarkerOptions.builder()
                              .setBaseOptions(
                                  BaseOptions.builder()
                                      .setModelAssetPath("hand_landmarker.task")
                                      .build()
                              )
                              .setRunningMode(RunningMode.VIDEO)
                              .setNumHands(2)
                              // The landmark geometry and one-shot timing filters below
                              // reject noise, so a slightly lower model threshold keeps
                              // a real pair of touching fingers from flickering out.
                              .setMinHandDetectionConfidence(.45f)
                              .setMinHandPresenceConfidence(.45f)
                              .setMinTrackingConfidence(.45f)
                              .build()
                          if (alive) landmarker = HandLandmarker.createFromOptions(this, options)
                          main.post { if (alive) startCamera() }
                      } catch (e: Exception) {
                          main.post { if (alive) fail("인식 모델 오류: ${e.message}") }
                      }
                  }
                  return START_NOT_STICKY
              }
          
              private fun rotation(): Int = getSystemService(DisplayManager::class.java)
                  .getDisplay(android.view.Display.DEFAULT_DISPLAY)?.rotation ?: Surface.ROTATION_0
          
              private fun startCamera() {
                  val future = ProcessCameraProvider.getInstance(this)
                  future.addListener({
                      if (!alive) return@addListener
                      try {
                          val cameraProvider = future.get()
                          provider = cameraProvider
                          @Suppress("DEPRECATION")
                          val useCase = ImageAnalysis.Builder()
                              .setTargetResolution(Size(640, 480))
                              .setTargetRotation(rotation())
                              .setBackpressureStrategy(ImageAnalysis.STRATEGY_KEEP_ONLY_LATEST)
                              .setOutputImageFormat(ImageAnalysis.OUTPUT_IMAGE_FORMAT_RGBA_8888)
                              .build()
                          analysis = useCase
                          useCase.setAnalyzer(worker) { frame -> analyze(frame) }
                          val camera = cameraProvider.bindToLifecycle(
                              this,
                              CameraSelector.DEFAULT_FRONT_CAMERA,
                              useCase
                          )
                          camera.cameraInfo.cameraState.observe(this) { state ->
                              if (state.error != null) {
                                  RuntimeState.message =
                                      "카메라 상태 오류 ${state.error?.code} · 다른 카메라 앱을 닫으세요"
                              }
                          }
                      } catch (e: Exception) {
                          fail("카메라 연결 실패: ${e.message}")
                      }
                  }, ContextCompat.getMainExecutor(this))
              }
          
              private fun analyze(frame: ImageProxy) {
                  var raw: Bitmap? = null
                  var transformed: Bitmap? = null
                  try {
                      if (!alive) return
                      val now = SystemClock.uptimeMillis()
                      if (now - lastSubmitted < 40L) return
                      lastSubmitted = now
                      RuntimeState.lastFrame = now
          
                      val currentRotation = rotation()
                      if (currentRotation != lastRotation) {
                          lastRotation = currentRotation
                          main.post {
                              if (alive) {
                                  analysis?.targetRotation = currentRotation
                                  twoFingerEngine.reset()
                                  rightInputEngine.reset()?.let {
                                      GestureAccessibilityService.instance?.endDrag()
                                  }
                                  rightPinchStabilizer.reset()
                                  HandOverlayManager.update(emptyList())
                              }
                          }
                          return
                      }
          
                      // ImageProxy.toBitmap handles RGBA row stride and padding correctly.
                      val bitmap = frame.toBitmap()
                      raw = bitmap
                      val matrix = Matrix().apply {
                          postRotate(frame.imageInfo.rotationDegrees.toFloat())
                          postScale(-1f, 1f)
                      }
                      val rotated = Bitmap.createBitmap(
                          bitmap, 0, 0, bitmap.width, bitmap.height, matrix, true
                      )
                      transformed = rotated
                      val image = BitmapImageBuilder(rotated).build()
                      val result = try {
                          landmarker?.detectForVideo(image, now)
                      } finally {
                          image.close()
                      }
                      if (result == null) return
          
                      val hands = classifyHands(result)
                      val right = hands.firstOrNull { it.isRight }
                      val left = hands.firstOrNull { it.isLeft }
                      val shadows = hands.filter { it.points.size == 21 }
                      val indexRatio = right?.thumbIndexRatio
                      val middleRatio = right?.thumbMiddleRatio
                      // Use the physical pinch centre rather than the index fingertip.
                      // This averages landmark jitter from both fingers and keeps taps,
                      // held input and drag movement on one consistent coordinate.
                      val pointerPoint = right?.thumbIndexCenter
                      val volumePoint = right?.thumbMiddleCenter
                      val fingersTogether = left?.indexMiddleTogether == true
                      val gesturePoint = left?.indexMiddleCenter
                      framesFailed = 0
          
                      main.post {
                          if (!alive || SystemClock.uptimeMillis() - now > 450L) return@post
                          HandOverlayManager.update(shadows)
                          val stablePinch = rightPinchStabilizer.sample(now, indexRatio, middleRatio)
                          val clickPinch = stablePinch.index
                          val volumePinch = stablePinch.middle
                          val rightAction = rightInputEngine.sample(
                              now,
                              clickPinch,
                              volumePinch,
                              pointerPoint,
                              volumePoint
                          )
                          if (rightAction != null) {
                              twoFingerEngine.reset()
                              val accessibility = GestureAccessibilityService.instance
                              RuntimeState.message = when (rightAction) {
                                  is RightHandAction.Tap -> {
