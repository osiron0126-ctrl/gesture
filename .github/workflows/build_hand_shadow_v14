          package com.sc.millegesture
          import kotlin.math.abs
          
          enum class Direction { LEFT, RIGHT, UP, DOWN }
          /** A fired gesture stays latched until a deliberate fist or prolonged absence. */
          class GestureEngine {
              private var locked = false
              val awaitingRelease: Boolean get() = locked
              private var releaseSince: Long? = null
              private var origin: Pair<Float, Float>? = null
              private var originAt = 0L
              private var previousAt = -1L
              fun reset() { locked = false; releaseSince = null; origin = null; previousAt = -1L }
              fun sample(t: Long, x: Float, y: Float, open: Boolean, fist: Boolean,
                         absent: Boolean, threshold: Float = .16f): Direction? {
                  if (previousAt >= 0 && t - previousAt > 350) { origin = null; releaseSince = null }
                  previousAt = t
                  if (locked) {
                      if (fist || absent) {
                          val since = releaseSince ?: t.also { releaseSince = it }
                          if (t - since >= if (fist) 350L else 700L) {
                              locked = false; origin = null; releaseSince = null
                          }
                      } else releaseSince = null
                      return null
                  }
                  if (!open) { origin = null; return null }
                  val o = origin
                  if (o == null) { origin = x to y; originAt = t; return null }
                  val dx = x - o.first; val dy = y - o.second
                  if (t - originAt > 850) { origin = x to y; originAt = t; return null }
                  if (t - originAt < 120) return null
                  val direction = when {
                      abs(dx) >= threshold && abs(dx) > abs(dy) * 1.4f -> if (dx > 0) Direction.RIGHT else Direction.LEFT
                      abs(dy) >= threshold && abs(dy) > abs(dx) * 1.4f -> if (dy > 0) Direction.DOWN else Direction.UP
                      else -> null
                  }
                  if (direction != null) { locked = true; origin = null; releaseSince = null }
                  return direction
              }
          }
