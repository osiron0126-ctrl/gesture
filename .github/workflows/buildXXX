                          startActivity(intent)
                      }
                  })

                  root.addView(button("4. START → 밀리 실행") {
                      startGestureAndMillie()
                  })

                  root.addView(button("STOP") {
                      stopService(Intent(this, GestureCameraService::class.java))
                      Toast.makeText(this, "제스처 인식을 중지했습니다.", Toast.LENGTH_SHORT).show()
                  })

                  setContentView(root)
              }

              private fun startGestureAndMillie() {
                  if (ContextCompat.checkSelfPermission(this, Manifest.permission.CAMERA)
                      != PackageManager.PERMISSION_GRANTED) {
                      cameraPermission.launch(Manifest.permission.CAMERA)
                      return
                  }

                  if (!isAccessibilityEnabled()) {
                      Toast.makeText(
                          this,
                          "먼저 접근성 설정에서 ${getString(R.string.app_name)} 서비스를 켜주세요.",
                          Toast.LENGTH_LONG
                      ).show()
                      startActivity(Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS))
                      return
                  }

                  if (!canDrawOverlays(this)) {
                      Toast.makeText(
                          this,
                          "손 그림자를 띄우려면 화면 위 표시 권한이 필요합니다.",
                          Toast.LENGTH_LONG
                      ).show()
                      startActivity(
                          Intent(
                              Settings.ACTION_MANAGE_OVERLAY_PERMISSION,
                              Uri.parse("package:$packageName")
                          )
                      )
                      return
                  }

                  val serviceIntent = Intent(this, GestureCameraService::class.java)
                      .setAction(GestureCameraService.ACTION_START)
                  ContextCompat.startForegroundService(this, serviceIntent)

                  val launch = packageManager.getLaunchIntentForPackage(MILLIE_PACKAGE)
                  if (launch != null) {
                      launch.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
                      startActivity(launch)
                  } else {
                      Toast.makeText(this, "밀리의 서재가 설치되어 있지 않습니다.", Toast.LENGTH_LONG).show()
                      try {
                          startActivity(
                              Intent(
                                  Intent.ACTION_VIEW,
                                  Uri.parse("market://details?id=$MILLIE_PACKAGE")
                              )
                          )
                      } catch (_: Exception) {
                          startActivity(
                              Intent(
                                  Intent.ACTION_VIEW,
                                  Uri.parse("https://play.google.com/store/apps/details?id=$MILLIE_PACKAGE")
                              )
                          )
                      }
                  }
              }

              private fun isAccessibilityEnabled(): Boolean {
                  val target = ComponentName(this, GestureAccessibilityService::class.java)
                  val enabled = Settings.Secure.getString(
                      contentResolver,
                      Settings.Secure.ENABLED_ACCESSIBILITY_SERVICES
                  ) ?: return false

                  return enabled.split(':').any {
                      ComponentName.unflattenFromString(it) == target
                  }
              }

              private fun updateStatus() {
                  if (!::status.isInitialized) return
                  val camera = ContextCompat.checkSelfPermission(this, Manifest.permission.CAMERA) ==
                      PackageManager.PERMISSION_GRANTED
                  val access = isAccessibilityEnabled()
                  val overlay = canDrawOverlays(this)

                  status.text = buildString {
                      append(if (camera) "● 카메라 준비됨" else "○ 카메라 권한 필요")
                      append("\n")
                      append(if (access) "● 접근성 서비스 준비됨" else "○ 접근성 서비스 필요")
                      append("\n")
                      append(if (overlay) "● 손 그림자 오버레이 준비됨" else "○ 화면 위 표시 권한 필요")
                  }
              }
          }
          EOF

