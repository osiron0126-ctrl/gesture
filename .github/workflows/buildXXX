                  private const val CHANNEL_ID = "gesture_camera"
                  private const val NOTIFICATION_ID = 4101

                  private const val SWIPE_DISTANCE = 0.16f
                  private const val MIN_SWIPE_MS = 120L
                  private const val MAX_SWIPE_MS = 850L
                  private const val COOLDOWN_MS = 900L
                  private const val OPEN_PALM_SCORE = 0.55f
              }

              private var cameraProvider: ProcessCameraProvider? = null
              private var recognizer: GestureRecognizer? = null
              private lateinit var executor: ExecutorService
              private var lastFrameSubmitted = 0L

              private var startX: Float? = null
              private var startTime = 0L
              private var lastActionTime = 0L

              override fun onCreate() {
                  super.onCreate()
                  executor = Executors.newSingleThreadExecutor()
                  createNotificationChannel()
                  if (Settings.canDrawOverlays(this)) {
                      HandOverlayManager.ensure(this)
                  }
              }

              override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
                  if (intent?.action == ACTION_STOP) {
                      stopSelf()
                      return START_NOT_STICKY
                  }

                  startForeground(NOTIFICATION_ID, buildNotification())

                  if (ContextCompat.checkSelfPermission(this, Manifest.permission.CAMERA)
                      != PackageManager.PERMISSION_GRANTED) {
                      stopSelf()
                      return START_NOT_STICKY
                  }

                  if (recognizer == null) setupRecognizer()
                  if (recognizer == null) {
                      stopSelf()
                      return START_NOT_STICKY
                  }
                  if (cameraProvider == null) startCamera()

                  return START_STICKY
              }

              private fun setupRecognizer() {
                  try {
                      val base = BaseOptions.builder()
                          .setModelAssetPath("gesture_recognizer.task")
                          .build()

                      val options = GestureRecognizer.GestureRecognizerOptions.builder()
                          .setBaseOptions(base)
                          .setRunningMode(RunningMode.LIVE_STREAM)
                          .setMinHandDetectionConfidence(0.55f)
                          .setMinHandPresenceConfidence(0.55f)
                          .setMinTrackingConfidence(0.55f)
                          .setResultListener { result, _ ->
                              handleResult(result)
                          }
                          .setErrorListener { error ->
                              Log.e("SCGesture", "MediaPipe error", error)
                          }
                          .build()

                      recognizer = GestureRecognizer.createFromOptions(this, options)
                  } catch (e: Exception) {
                      Log.e("SCGesture", "Gesture recognizer init failed", e)
                      stopSelf()
                  }
              }

              private fun startCamera() {
                  val future = ProcessCameraProvider.getInstance(this)
                  future.addListener({
                      try {
                          val provider = future.get()
                          cameraProvider = provider

                          @Suppress("DEPRECATION")
                          val analysis = ImageAnalysis.Builder()
                              .setTargetResolution(Size(640, 480))
                              .setBackpressureStrategy(ImageAnalysis.STRATEGY_KEEP_ONLY_LATEST)
                              .setOutputImageFormat(ImageAnalysis.OUTPUT_IMAGE_FORMAT_RGBA_8888)
                              .build()

                          analysis.setAnalyzer(executor) { image ->
                              analyze(image)
                          }

                          provider.unbindAll()
                          provider.bindToLifecycle(
                              this,
                              CameraSelector.DEFAULT_FRONT_CAMERA,
                              analysis
                          )
                      } catch (e: Exception) {
                          Log.e("SCGesture", "Camera start failed", e)
                          stopSelf()
                      }
                  }, ContextCompat.getMainExecutor(this))
              }

              private fun analyze(image: ImageProxy) {
                  val now = SystemClock.uptimeMillis()
                  if (now - lastFrameSubmitted < 80L) {
                      image.close()
                      return
                  }
                  lastFrameSubmitted = now

                  try {
                      val rotation = image.imageInfo.rotationDegrees
                      val width = image.width
                      val height = image.height

                      val bitmap = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888)
                      bitmap.copyPixelsFromBuffer(image.planes[0].buffer)
                      image.close()

                      val matrix = Matrix().apply {
                          postRotate(rotation.toFloat())
                          postScale(-1f, 1f, width.toFloat(), height.toFloat())
                      }

                      val rotated = Bitmap.createBitmap(
                          bitmap, 0, 0, bitmap.width, bitmap.height, matrix, true
                      )
                      if (rotated !== bitmap) bitmap.recycle()

                      val mpImage = BitmapImageBuilder(rotated).build()
                      recognizer?.recognizeAsync(mpImage, SystemClock.uptimeMillis())
                  } catch (e: Exception) {
                      runCatching { image.close() }
                      Log.e("SCGesture", "Frame analysis failed", e)
                  }
              }

              private fun handleResult(result: GestureRecognizerResult) {
                  val gestureLists = result.gestures()
                  val handLists = result.landmarks()

                  val visibleHand: List<NormalizedLandmark>? =
                      handLists.firstOrNull()?.takeIf { it.isNotEmpty() }

                  HandOverlayManager.update(this, visibleHand)

                  if (gestureLists.isEmpty() || handLists.isEmpty() || gestureLists[0].isEmpty()) {
                      resetTracking()
                      return
                  }

                  val top = gestureLists[0][0]
                  if (top.categoryName() != "Open_Palm" || top.score() < OPEN_PALM_SCORE) {
                      resetTracking()
                      return
                  }

                  val hand = handLists[0]
                  if (hand.isEmpty()) {
                      resetTracking()
                      return
                  }

                  val now = SystemClock.uptimeMillis()
                  val x = hand[0].x()

                  val sx = startX
                  if (sx == null) {
                      startX = x
                      startTime = now
                      return
                  }

                  val dt = now - startTime
                  if (dt > MAX_SWIPE_MS) {
                      startX = x
                      startTime = now
                      return
                  }

                  val dx = x - sx
                  if (dt >= MIN_SWIPE_MS &&
                      abs(dx) >= SWIPE_DISTANCE &&
                      now - lastActionTime >= COOLDOWN_MS) {

                      val nextPage = dx > 0f
                      val tapped = GestureAccessibilityService.instance?.pageTap(nextPage) == true

                      if (tapped) {
                          lastActionTime = now
                      }
                      resetTracking()
                  }
              }

              private fun resetTracking() {
                  startX = null
                  startTime = 0L
              }

              private fun createNotificationChannel() {
                  if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
                      val nm = getSystemService(NotificationManager::class.java)
                      nm.createNotificationChannel(
                          NotificationChannel(
                              CHANNEL_ID,
                              "손 제스처 카메라",
                              NotificationManager.IMPORTANCE_LOW
                          )
                      )
                  }
              }

              private fun buildNotification(): android.app.Notification {
                  val openApp = Intent(this, MainActivity::class.java)
                  val contentIntent = PendingIntent.getActivity(
                      this,
                      10,
                      openApp,
                      PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
                  )

                  val stopIntent = Intent(this, GestureCameraService::class.java)
                      .setAction(ACTION_STOP)
                  val stopPending = PendingIntent.getService(
                      this,
                      11,
                      stopIntent,
                      PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
                  )

                  return NotificationCompat.Builder(this, CHANNEL_ID)
                      .setSmallIcon(android.R.drawable.ic_menu_camera)
                      .setContentTitle(getString(R.string.app_name))
                      .setContentText("손 제스처 인식 중 · 밀리의 서재 전용")
                      .setOngoing(true)
                      .setContentIntent(contentIntent)
                      .addAction(0, "중지", stopPending)
                      .build()
              }

              override fun onDestroy() {
                  runCatching { cameraProvider?.unbindAll() }
                  cameraProvider = null
                  runCatching { recognizer?.close() }
                  recognizer = null
                  HandOverlayManager.remove()
                  if (::executor.isInitialized) executor.shutdownNow()
                  super.onDestroy()
              }
          }
