          package com.sc.millegesture

          import android.Manifest
          import android.content.ComponentName
          import android.content.Intent
          import android.content.pm.PackageManager
          import android.graphics.Color
          import android.net.Uri
          import android.os.Build
          import android.os.Bundle
          import android.provider.Settings
          import android.provider.Settings.canDrawOverlays
          import android.view.Gravity
          import android.view.ViewGroup
          import android.widget.Button
          import android.widget.LinearLayout
          import android.widget.TextView
          import android.widget.Toast
          import androidx.activity.result.contract.ActivityResultContracts
          import androidx.appcompat.app.AppCompatActivity
          import androidx.core.content.ContextCompat

          class MainActivity : AppCompatActivity() {

              companion object {
                  const val MILLIE_PACKAGE = "kr.co.millie.millieshelf"
              }

              private lateinit var status: TextView

              private val cameraPermission =
                  registerForActivityResult(ActivityResultContracts.RequestPermission()) { granted ->
                      updateStatus()
                      if (!granted) {
                          Toast.makeText(this, "카메라 권한이 필요합니다.", Toast.LENGTH_LONG).show()
                      }
                  }

              private val notificationPermission =
                  registerForActivityResult(ActivityResultContracts.RequestPermission()) { }

              override fun onCreate(savedInstanceState: Bundle?) {
                  super.onCreate(savedInstanceState)
                  buildUi()

                  if (Build.VERSION.SDK_INT >= 33 &&
                      ContextCompat.checkSelfPermission(this, Manifest.permission.POST_NOTIFICATIONS)
                      != PackageManager.PERMISSION_GRANTED) {
                      notificationPermission.launch(Manifest.permission.POST_NOTIFICATIONS)
                  }
              }

              override fun onResume() {
                  super.onResume()
                  updateStatus()
              }

              private fun buildUi() {
                  val dp = resources.displayMetrics.density
                  val root = LinearLayout(this).apply {
                      orientation = LinearLayout.VERTICAL
                      gravity = Gravity.CENTER_HORIZONTAL
                      setPadding((24 * dp).toInt(), (36 * dp).toInt(), (24 * dp).toInt(), (24 * dp).toInt())
                      setBackgroundColor(Color.rgb(17, 17, 17))
                  }

                  val title = TextView(this).apply {
                      text = getString(R.string.app_name)
                      textSize = 28f
                      setTextColor(Color.WHITE)
                      gravity = Gravity.CENTER
                  }
                  root.addView(
                      title,
                      LinearLayout.LayoutParams(
                          ViewGroup.LayoutParams.MATCH_PARENT,
                          ViewGroup.LayoutParams.WRAP_CONTENT
                      )
                  )

                  val desc = TextView(this).apply {
                      text = "\n손바닥을 펴고 좌우로 휙 움직이세요.\n→ 오른쪽: 다음 페이지\n← 왼쪽: 이전 페이지\n\n손이 인식되면 검은 반투명 손 그림자가 뜹니다.\n페이지 넘김 탭은 밀리의 서재에서만 발생합니다."
                      textSize = 16f
                      setTextColor(Color.LTGRAY)
                      gravity = Gravity.CENTER
                  }
                  root.addView(desc)

                  status = TextView(this).apply {
                      textSize = 15f
                      setTextColor(Color.WHITE)
                      gravity = Gravity.CENTER
                      setPadding(0, (24 * dp).toInt(), 0, (16 * dp).toInt())
                  }
                  root.addView(status)

                  fun button(text: String, action: () -> Unit): Button =
                      Button(this).apply {
                          this.text = text
                          setOnClickListener { action() }
                      }

                  root.addView(button("1. 카메라 권한 허용") {
                      if (ContextCompat.checkSelfPermission(this, Manifest.permission.CAMERA)
                          != PackageManager.PERMISSION_GRANTED) {
                          cameraPermission.launch(Manifest.permission.CAMERA)
                      } else {
                          Toast.makeText(this, "이미 허용되어 있습니다.", Toast.LENGTH_SHORT).show()
                      }
                  })

                  root.addView(button("2. 접근성 서비스 켜기") {
                      startActivity(Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS))
                  })

                  root.addView(button("3. 화면 위 표시 권한 허용") {
                      if (canDrawOverlays(this)) {
                          Toast.makeText(this, "이미 허용되어 있습니다.", Toast.LENGTH_SHORT).show()
                      } else {
                          val intent = Intent(
                              Settings.ACTION_MANAGE_OVERLAY_PERMISSION,
                              Uri.parse("package:$packageName")
